{
  "manifest_version": 3,
  "name": "Three Ar",
  "version": "2.4.0",
  "description": "Automações de cotação Three Ar — produtos, descrições, preços, oferta CRM e follow-up no prycable.com.br",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Three Ar",
    "default_icon": {
      "16":  "images/LogoCRM.png",
      "32":  "images/LogoCRM.png",
      "48":  "images/LogoCRM.png",
      "128": "images/LogoCRM.png"
    }
  },
  "icons": {
    "16":  "images/LogoCRM.png",
    "32":  "images/LogoCRM.png",
    "48":  "images/LogoCRM.png",
    "128": "images/LogoCRM.png"
  }
}
